# Machine-local values. Copy to .env and keep it out of Git.
TABCOMPLETE_OBS_DATA_ROOT=/verified/external/mount/docker/tabcomplete-observability
TABCOMPLETE_OBS_VOLUME_SOURCE=/dev/replace-with-verified-partition
TABCOMPLETE_OBS_VOLUME_UUID=replace-with-live-filesystem-uuid
TABCOMPLETE_OBS_TAILSCALE_IP=100.64.0.1
TABCOMPLETE_OBS_GATEWAY_PORT=9090
TABCOMPLETE_OBS_SIGNOZ_PORT=8080
TABCOMPLETE_OBS_MCP_PORT=8000
TABCOMPLETE_OBS_OTLP_GRPC_PORT=4317
TABCOMPLETE_OBS_OTLP_HTTP_PORT=4318
TABCOMPLETE_OBS_ALLOWED_HOSTS=kiwi,kiwi.example.ts.net,100.64.0.1,crabcake.example.ts.net
SIGNOZ_API_KEY=replace-with-read-only-service-account-key
TABCOMPLETE_OBS_POSTGRES_PASSWORD=replace-with-random-hex-password
TABCOMPLETE_ARTIFACT_UPLOAD_TOKEN=replace-with-random-server-side-upload-token
TABCOMPLETE_ARTIFACT_CAP_BYTES=21474836480
TABCOMPLETE_ARTIFACT_RETENTION_DAYS=30
TABCOMPLETE_OBS_HIGH_WATER_BYTES=107374182400
