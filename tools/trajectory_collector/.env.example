# Example (tracked) collector deployment config. Copy to untracked `.env`
# via scripts/start.sh or `cp .env.example .env` and adjust the bind address.
#
# The collector must never be exposed publicly: TABCOMPLETE_TAILSCALE_BIND_ADDR
# must be a Tailnet IPv4 address (see scripts/resolve-tailscale.sh).
TABCOMPLETE_TAILSCALE_HOST=crabcake
TABCOMPLETE_TAILSCALE_BIND_ADDR=100.64.0.1
TABCOMPLETE_COLLECTOR_PORT=8787
